{
  "dashboard": {
    "title": "Kubernetes Cluster",
    "uid": "kubernetes-cluster",
    "tags": ["kubernetes", "cluster"],
    "timezone": "browser",
    "panels": [
      {
        "title": "Pods Running vs Desired",
        "type": "graph",
        "targets": [
          {
            "expr": "kube_pod_status_phase{phase=\"Running\"}",
            "legendFormat": "Running"
          },
          {
            "expr": "kube_pod_status_phase{phase=\"Pending\"}",
            "legendFormat": "Pending"
          }
        ],
        "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8}
      },
      {
        "title": "Node CPU Usage",
        "type": "graph",
        "targets": [
          {
            "expr": "sum by(node) (rate(node_cpu_seconds_total{mode!=\"idle\"}[5m]))",
            "legendFormat": "{{node}}"
          }
        ],
        "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8}
      },
      {
        "title": "Pod Memory Usage",
        "type": "graph",
        "targets": [
          {
            "expr": "container_memory_usage_bytes{container!=\"\"}",
            "legendFormat": "{{pod}}"
          }
        ],
        "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8}
      },
      {
        "title": "Container Restarts",
        "type": "graph",
        "targets": [
          {
            "expr": "kube_pod_container_status_restarts_total",
            "legendFormat": "{{pod}}/{{container}}"
          }
        ],
        "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8}
      }
    ],
    "time": {"from": "now-1h", "to": "now"},
    "refresh": "30s"
  }
}